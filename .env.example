# Copy this file to .env and fill it in. Never commit .env (it holds passwords).

# --- Your business
SITE_NAME=Liquidator USA
CONTACT_EMAIL=sales@liquidatorusa.com
CONTACT_PHONE=
WAREHOUSE_ADDRESS=Ontario, CA 91761
DELIVERY_FEE=150

# Your business WhatsApp number with country code, e.g. +1 626 555 0199
WHATSAPP_NUMBER=
# Shown prominently on the Chinese seller site
WECHAT_ID=

# --- Addresses: the English store is served on shop.liquidatorusa.com (set in the Cloudflare Tunnel),
# the Chinese seller site (for factories / stock owners) on this subdomain:
SELLER_SITE_DOMAIN=partner.liquidatorusa.com
# Name shown on the Chinese site; leave blank to use SITE_NAME
SELLER_SITE_NAME=

# --- Security (required)
# A long password for /admin
ADMIN_PASSWORD=
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# --- Cloudflare Tunnel token (Zero Trust > Networks > Tunnels > your tunnel)
CLOUDFLARE_TUNNEL_TOKEN=

# --- Optional: card payments. Leave blank to take orders as pay-by-invoice
STRIPE_SECRET_KEY=
# How customers pay an invoice. Printed on every invoice. Use \n for a new line, e.g.
# PAYMENT_INSTRUCTIONS=Zelle: pay@liquidatorusa.com\nCheck payable to Liquidator USA LLC
PAYMENT_INSTRUCTIONS=

# --- Email: alerts to you for new orders / quote requests / factory applications,
# order confirmations and invoices to customers. Test it on Admin > Email after starting.
# Examples (pick one provider):
#   Brevo (free 300/day):  SMTP_HOST=smtp-relay.brevo.com  SMTP_PORT=587  SMTP_USER=<login>  SMTP_PASSWORD=<SMTP key>
#   Resend (free 100/day): SMTP_HOST=smtp.resend.com  SMTP_PORT=465  SMTP_USER=resend  SMTP_PASSWORD=<API key>
#   Gmail / Workspace:     SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_USER=you@gmail.com  SMTP_PASSWORD=<app password>
# Where alerts go (defaults to CONTACT_EMAIL)
NOTIFY_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# The "From" address. Must be verified with your email provider, e.g. sales@liquidatorusa.com
SMTP_FROM=

# --- Optional: largest upload in MB (spreadsheets, zip of photos). Keep under 100 behind Cloudflare.
MAX_UPLOAD_MB=95
